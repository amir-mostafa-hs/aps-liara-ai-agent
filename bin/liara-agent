#!/usr/bin/env bash
# Liara Agent CLI Companion Wrapper
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -f "$DIR/engine/.venv/bin/python" ]; then
  PYTHON_BIN="$DIR/engine/.venv/bin/python"
elif command -v python3 &> /dev/null; then
  PYTHON_BIN="python3"
else
  echo "Error: Python 3 could not be found." >&2
  exit 1
fi

PYTHONPATH="$DIR" exec "$PYTHON_BIN" -m engine.cli "$@"

