# ==============================================================================
# Liara Deployment & SRE Agent - Environment Configuration Template
# Copy this file to .env and apps/web/.env before starting the stack:
#   cp .env.example .env
#   cp .env.example apps/web/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string for Prisma ORM. Default connects to local Docker container.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/liara_agent?schema=public"

# ------------------------------------------------------------------------------
# 2. Internal Microservice Security
# ------------------------------------------------------------------------------
# Shared secret passed via X-Internal-Secret header between Next.js and Python Engine.
# Change this to a random 32+ character alphanumeric string in production.
INTERNAL_AGENT_SECRET="dev-internal-secret-change-me"

# Base URL of the Python Agent Engine service
ENGINE_URL="http://127.0.0.1:8000"

# ------------------------------------------------------------------------------
# 3. Liara Cloud Credentials
# ------------------------------------------------------------------------------
# Your personal Liara API token from https://console.liara.ir/API
# Can also be dynamically configured via the Web UI dashboard (Step 1).
# Redacted automatically from logs, audit tables, and terminal streams.
LIARA_API_TOKEN=""

# ------------------------------------------------------------------------------
# 4. LLM / AI Engine Model Configuration
# ------------------------------------------------------------------------------
# OpenAI or compatible endpoint (OpenAI, OpenRouter, Azure, Ollama, etc.)
# Required for natural-language chat and tool calling; a blank value disables them.
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL_NAME="gpt-4o-mini"

# ------------------------------------------------------------------------------
# 5. Operator Web Session & Auth Credentials
# ------------------------------------------------------------------------------
# HMAC secret for signing tamper-proof session cookies
APP_SECRET="dev-session-secret-change-me"

# Default operator credentials for accessing /login
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"

# Optional public demo login shown on the /login page. The demo account is
# created in PostgreSQL without Liara credentials and cannot save a Liara token.
# Because these values are public, use this account only for non-sensitive demos.
DEMO_USERNAME=""
DEMO_PASSWORD=""
