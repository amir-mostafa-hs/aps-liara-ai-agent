generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(uuid())
  username     String           @unique
  passwordHash String
  liaraToken   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  approvals    ActionApproval[]
  runs         Run[]
}

model Run {
  id               String           @id @default(uuid())
  userId           String?
  sourceKind       String           // "local" or "github"
  sourcePath       String?
  targetApp        String?
  platform         String?
  status           String           @default("created") // created, inspecting, plan_ready, awaiting_approval, executing, verifying, diagnosing, succeeded, failed, inconclusive, cancelled
  providerStatus   String?
  planDetails      Json?
  remediationPlan  Json?
  redactedLogs     String?          @db.Text
  verification     Json?
  startedAt        DateTime         @default(now())
  finishedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  approvals        ActionApproval[]
  auditLogs        AuditLog[]

  @@index([status])
  @@index([createdAt])
}

model ActionApproval {
  id         String   @id @default(uuid())
  runId      String
  userId     String?
  actionId   String
  operation  String
  target     String
  approved   Boolean
  planDigest String
  approvedAt DateTime @default(now())
  run        Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([planDigest])
}

model AuditLog {
  id        String   @id @default(uuid())
  runId     String?
  action    String
  actor     String   @default("system")
  metadata  Json?
  timestamp DateTime @default(now())
  run       Run?     @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([timestamp])
}

